-- Initial www-gallais.cabal generated by cabal init.  For further
-- documentation, see http://haskell.org/cabal/users-guide/

name:                www-gallais
version:             0.1.0.0
synopsis:            My website, now generated using Hakyll
-- description:
license:             GPL-3
license-file:        LICENSE
author:              gallais
maintainer:          guillaume.allais@ens-lyon.org
-- copyright:
category:            Web
build-type:          Simple
cabal-version:       >= 1.10

executable www-gallais
  main-is:             site.hs
  -- other-modules:
  default-extensions:  DeriveFoldable
                     , DeriveFunctor
                     , DeriveTraversable
                     , FlexibleContexts
                     , LambdaCase
                     , OverloadedStrings
                     , RecordWildCards
                     , TupleSections
                     , ViewPatterns

  build-depends: base >=4.8 && <5
               , bytestring >= 0.11 && <0.13
               , feed >=1.0 && <1.4
               , hakyll >=4.7 && <4.17
               , mtl >=2.2 && <2.4
               , parsec >=3.0 && <3.2
               , text >=1.2 && <2.2
               , time >= 1.6 && <1.13
               , xml-types >= 0.3 && < 0.4
               , old-locale >= 1.0 && <1.1

  -- hs-source-dirs:
  default-language: Haskell2010

  other-modules: BlogList
               , CoAuthors
               , Links
               , Publications
               , Text.BBCode.Parser
               , Text.BBCode.PrettyPrinter
               , Text.BBCode.Tokenizer
               , Text.HTML.Combinators

  ghc-options: -Wunused-imports
               -Wall
